library(ggplot2)
library(dplyr)
# Mean–sample-size parameterization:
#   alpha = mu * nu,  beta = (1 - mu) * nu
mu <- 0.7
ss <- c(10, 100, 1000, 10000)
x <- seq(0, 1, length.out = 1000)
df <- do.call(rbind, lapply(ss, function(nu) {
data.frame(
x       = x,
density = dbeta(x, shape1 = mu * nu, shape2 = (1 - mu) * nu),
nu      = nu
)
}))
# Order facets and give them readable labels
df$nu <- factor(df$nu,
levels = ss,
labels = paste0("nu == ", ss))
ggplot(df, aes(x = x, y = density)) +
geom_area(fill = "#378ADD", alpha = 0.25) +
geom_line(color = "#185FA5", linewidth = 0.8) +
geom_vline(xintercept = mu, linetype = "dashed", color = "grey40") +
facet_wrap(~ nu, scales = "free_y", labeller = label_parsed) +
labs(
title    = "Beta distribution with mean = 0.7",
subtitle = expression(alpha == mu * nu * ",  " * beta == (1 - mu) * nu),
# Mean–sample-size parameterization:
#   alpha = mu * nu,  beta = (1 - mu) * nu
mu <- 0.7
ss <- c(10, 100, 1000, 10000)
x <- seq(0, 1, length.out = 1000)
df <- do.call(rbind, lapply(ss, function(nu) {
data.frame(
x       = x,
density = dbeta(x, shape1 = mu * nu, shape2 = (1 - mu) * nu),
nu      = nu
)
}))
# Order facets and give them readable labels
df$nu <- factor(df$nu,
levels = ss,
labels = paste0("nu == ", ss))
ggplot(df, aes(x = x, y = density)) +
geom_area(fill = "#378ADD", alpha = 0.25) +
geom_line(color = "#185FA5", linewidth = 0.8) +
geom_vline(xintercept = mu, linetype = "dashed", color = "grey40") +
facet_wrap(~ nu, scales = "free_y", labeller = label_parsed) +
labs(
title    = "Beta distribution with mean = 0.7",
subtitle = expression(alpha == mu * nu * ",  " * beta == (1 - mu) * nu),
ggplot(df, aes(x = x, y = density)) +
geom_area(fill = "#378ADD", alpha = 0.25) +
geom_line(color = "#185FA5", linewidth = 0.8) +
geom_vline(xintercept = mu, linetype = "dashed", color = "grey40") +
facet_wrap(~ nu, scales = "free_y", labeller = label_parsed) +
labs(
title    = "Beta distribution with mean = 0.7",
x        = "x",
y        = "Density"
) +
theme_minimal(base_size = 13) +
theme(
strip.text = element_text(face = "bold"),
plot.title = element_text(face = "bold")
)
