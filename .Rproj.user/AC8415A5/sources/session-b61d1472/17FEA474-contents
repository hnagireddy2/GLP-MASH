      dq <- res$QALY[res$Strategy == "Semaglutide"] - res$QALY[res$Strategy == "LSM"]
      if (abs(dq) < 1e-8) return(NA_real_)
      dc / dq
    }
  )
  df <- dplyr::bind_rows(results)
  df$Strategy <- strat_name
  df
