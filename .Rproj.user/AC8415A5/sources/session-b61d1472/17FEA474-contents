dcc_mort_monthly <- mean(
  (trace_lsm[dcc_window, "DCC"] * p_prog_month$DCC_Death) /
  pmax(trace_lsm[dcc_window, "DCC"], 1e-8)
)
dcc_mort_annual <- rate_to_prob(prob_to_rate(dcc_mort_monthly) * 12)

