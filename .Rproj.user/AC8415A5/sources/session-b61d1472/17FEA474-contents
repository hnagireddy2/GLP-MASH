#############################################################
########## Define a generate_psa_params() function ##########
#############################################################

generate_psa_params <- function(n_sim) {

  ## Helpers
  gamma_params <- function(mean, se) {
    list(shape = (mean/se)^2, scale = se^2/mean)
  }
  beta_params <- function(mean, se) {
    # clamp se so alpha/beta stay positive
    se   <- min(se, sqrt(mean * (1 - mean)) * 0.99)
    alpha <- mean * (mean*(1-mean)/se^2 - 1)
    beta  <- (1-mean) * (mean*(1-mean)/se^2 - 1)
    list(shape1 = max(alpha, 0.01), shape2 = max(beta, 0.01))
  }
  se_from_range <- function(lo, hi) (hi - lo) / 4

  # -----------------------------------------------------------
  # ADOLESCENT UNCERTAINTY MULTIPLIER
  # -----------------------------------------------------------
  ped_mult_hazard <- 1.25   # fibrosis & disease-state hazards
  ped_mult_te     <- 1.25   # treatment effects (RCT-informed)
  ped_mult_cost   <- 1.25   # costs (price-list anchored)
  ped_mult_util   <- 1.25   # utility decrements (adult-derived)

  df <- data.frame(

    ## TREATMENT EFFECTS (log-normal) 
    rr_sema_regress  = rlnorm(n_sim,
                              meanlog = log(1.5625),
                              sdlog   = se_from_range(log(1.5625), log(1.7282)) * ped_mult_te),
    rr_sema_progress = rlnorm(n_sim,
                              meanlog = log(0.6097),
                              sdlog   = (log(0.6097) - log(0.3734)) / 1.96 * ped_mult_te),

    ## FIBROSIS TRANSITION HAZARDS (annual, gamma) 
    h_F0_F1 = rgamma(n_sim,
                     gamma_params(0.100, se_from_range(0.077, 0.132) * ped_mult_hazard)$shape,
                     scale = gamma_params(0.100, se_from_range(0.077, 0.132) * ped_mult_hazard)$scale),
    h_F1_F0 = rgamma(n_sim,
                     gamma_params(0.025, se_from_range(0.014, 0.046) * ped_mult_hazard)$shape,
                     scale = gamma_params(0.025, se_from_range(0.014, 0.046) * ped_mult_hazard)$scale),
    h_F1_F2 = rgamma(n_sim,
                     gamma_params(0.097, se_from_range(0.068, 0.137) * ped_mult_hazard)$shape,
                     scale = gamma_params(0.097, se_from_range(0.068, 0.137) * ped_mult_hazard)$scale),
    h_F2_F1 = rgamma(n_sim,
                     gamma_params(0.049, se_from_range(0.023, 0.105) * ped_mult_hazard)$shape,
                     scale = gamma_params(0.049, se_from_range(0.023, 0.105) * ped_mult_hazard)$scale),
    h_F2_F3 = rgamma(n_sim,
                     gamma_params(0.075, se_from_range(0.061, 0.092) * ped_mult_hazard)$shape,
                     scale = gamma_params(0.075, se_from_range(0.061, 0.092) * ped_mult_hazard)$scale),
    h_F3_F2 = rgamma(n_sim,
                     gamma_params(0.080, se_from_range(0.046, 0.138) * ped_mult_hazard)$shape,
                     scale = gamma_params(0.080, se_from_range(0.046, 0.138) * ped_mult_hazard)$scale),
    h_F3_F4 = rgamma(n_sim,
                     gamma_params(0.045, se_from_range(0.033, 0.060) * ped_mult_hazard)$shape,
                     scale = gamma_params(0.045, se_from_range(0.033, 0.060) * ped_mult_hazard)$scale),
    h_F4_F3 = rgamma(n_sim,
                     gamma_params(0.047, se_from_range(0.021, 0.108) * ped_mult_hazard)$shape,
                     scale = gamma_params(0.047, se_from_range(0.021, 0.108) * ped_mult_hazard)$scale),

    ## Advanced state hazards (annual) 
    h_F4_DCC    = rgamma(n_sim,
                         gamma_params(0.0378, se_from_range(0.03, 0.12) * ped_mult_hazard)$shape,
                         scale = gamma_params(0.0378, se_from_range(0.03, 0.12) * ped_mult_hazard)$scale),
    h_DCC_Death = rgamma(n_sim,
                         gamma_params(0.32, se_from_range(0.15, 0.40) * ped_mult_hazard)$shape,
                         scale = gamma_params(0.32, se_from_range(0.15, 0.40) * ped_mult_hazard)$scale),
    h_HCC_Death = rgamma(n_sim,
                         gamma_params(0.19, se_from_range(0.10, 0.38) * ped_mult_hazard)$shape,
                         scale = gamma_params(0.19, se_from_range(0.10, 0.38) * ped_mult_hazard)$scale),
    h_LT_Death  = rgamma(n_sim,
                         gamma_params(0.067, se_from_range(0.065, 0.10) * ped_mult_hazard)$shape,
                         scale = gamma_params(0.067, se_from_range(0.065, 0.10) * ped_mult_hazard)$scale),
    h_PostLT_Death = rgamma(n_sim,
                            gamma_params(0.036, se_from_range(0.03, 0.05) * ped_mult_hazard)$shape,
                            scale = gamma_params(0.036, se_from_range(0.03, 0.05) * ped_mult_hazard)$scale),

    ## STATE COSTS (gamma) 
    cost_F0_F2 = rgamma(n_sim,
                    gamma_params(8698, se_from_range(6958, 10436))$shape,
                    scale = gamma_params(8698, se_from_range(6958, 10436))$scale),
    
    ## STATE COSTS (gamma) — drawn then rank-ordered to enforce F3 < F4_CC < HCC < DCC
    cost_F3_raw    = rgamma(n_sim,
                       gamma_params(10372,  se_from_range(8297,   12447)  * ped_mult_cost)$shape,
                       scale = gamma_params(10372,  se_from_range(8297,   12447)  * ped_mult_cost)$scale),
    cost_F4_CC_raw = rgamma(n_sim,
                       gamma_params(42207,  se_from_range(33766,  50650)  * ped_mult_cost)$shape,
                       scale = gamma_params(42207,  se_from_range(33766,  50650)  * ped_mult_cost)$scale),
    cost_HCC_raw   = rgamma(n_sim,
                       gamma_params(141615, se_from_range(113292, 169939) * ped_mult_cost)$shape,
                       scale = gamma_params(141615, se_from_range(113292, 169939) * ped_mult_cost)$scale),
    cost_DCC_raw   = rgamma(n_sim,
                       gamma_params(195156, se_from_range(156125, 234187) * ped_mult_cost)$shape,
                       scale = gamma_params(195156, se_from_range(156125, 234187) * ped_mult_cost)$scale),
   
    ## LT complication additional cost (gamma)
    cost_lt_add = rgamma(n_sim,
                         gamma_params(lt_add_cost_base,
                                      se_from_range(lt_add_cost_low,
                                                    lt_add_cost_high) * ped_mult_cost)$shape,
                         scale = gamma_params(lt_add_cost_base,
                                              se_from_range(lt_add_cost_low,
                                                            lt_add_cost_high) * ped_mult_cost)$scale),

    ## Drug cost (gamma)
    cost_sema  = rgamma(n_sim,
                        gamma_params(6829, se_from_range(2940, 13658) * ped_mult_cost)$shape,
                        scale = gamma_params(6829, se_from_range(2940, 13658) * ped_mult_cost)$scale),

    ## HEALTH STATE UTILITIES (decrement, beta) 
    # SE is capped inside beta_params() to keep alpha/beta positive
    qdec_F0_F2  = rbeta(n_sim,
                        beta_params(0.016, 0.016 * 0.10 * ped_mult_util)$shape1,
                        beta_params(0.016, 0.016 * 0.10 * ped_mult_util)$shape2),
    qdec_F3     = rbeta(n_sim,
                        beta_params(0.145, 0.145 * 0.10 * ped_mult_util)$shape1,
                        beta_params(0.145, 0.145 * 0.10 * ped_mult_util)$shape2),
    qdec_F4_CC  = rbeta(n_sim,
                        beta_params(0.145, 0.145 * 0.10 * ped_mult_util)$shape1,
                        beta_params(0.145, 0.145 * 0.10 * ped_mult_util)$shape2),
    qdec_DCC    = rbeta(n_sim,
                        beta_params(0.155, 0.155 * 0.10 * ped_mult_util)$shape1,
                        beta_params(0.155, 0.155 * 0.10 * ped_mult_util)$shape2),
    qdec_HCC    = rbeta(n_sim,
                        beta_params(0.165, 0.165 * 0.10 * ped_mult_util)$shape1,
                        beta_params(0.165, 0.165 * 0.10 * ped_mult_util)$shape2),
    qdec_PostLT = rbeta(n_sim,
                        beta_params(0.036, 0.036 * 0.10 * ped_mult_util)$shape1,
                        beta_params(0.036, 0.036 * 0.10 * ped_mult_util)$shape2)

  )
# Enforce rank order: F3 < F4_CC < HCC < DCC
  cost_ordered <- t(apply(cbind(df$cost_F3_raw, df$cost_F4_CC_raw,
                                df$cost_HCC_raw, df$cost_DCC_raw), 1, sort))
  df$cost_F3    <- cost_ordered[, 1]
  df$cost_F4_CC <- cost_ordered[, 2]
  df$cost_HCC   <- cost_ordered[, 3]
  df$cost_DCC   <- cost_ordered[, 4]
  df$cost_F3_raw <- df$cost_F4_CC_raw <- df$cost_HCC_raw <- df$cost_DCC_raw <- NULL
  
  init_draws <- rdirichlet(n_sim, alpha = c(16, 28, 5, 1, 0.1))
  colnames(init_draws) <- c("init_F0","init_F1","init_F2","init_F3","init_F4_CC")
  df <- cbind(df, init_draws)

  return(df)
}

