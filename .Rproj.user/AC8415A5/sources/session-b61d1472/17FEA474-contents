## ---- Model wrapper: params -> calibration outputs --------------------------
run_mash_calib <- function(v_params) {
  raw    <- pmax(v_params[c("init_F0","init_F1","init_F2","init_F3")], 0)
  f4     <- max(0, 1 - sum(raw))
  all_p  <- c(raw, init_F4_CC = f4) / (sum(raw) + f4)

  v_init_c <- c(
    F0    = unname(all_p["init_F0"]),
    F1    = unname(all_p["init_F1"]),
    F2    = unname(all_p["init_F2"]),
    F3    = unname(all_p["init_F3"]),
    F4_CC = unname(all_p["init_F4_CC"]),
    DCC=0, HCC=0, LT_Y1_P=0, LT_Y1=0, Post_LT=0, Dead=0
  )

  pmb <- as.numeric(v_params["ped_mult_base"])

  aP_c <- build_a_P(
    rr_reg             = rr_regress,
    rr_prog            = rr_progress,
    p_prog_month_local = p_prog_month,
    treat_dur_cycles   = c(LSM = 0L, Semaglutide = 0L),
    treat_start_cycles = treat_start_immediate,
    ped_mult_base      = pmb
  )

  trace_c <- run_markov(aP_c[,,,"LSM"], v_init_c)

  adv_states <- c("F3","F4_CC","DCC","HCC","LT_Y1","LT_Y1_P","Post_LT")
  pct_adv <- sapply(lst_targets_calib$pct_adv$age, function(a) {
    sum(trace_c[which.min(abs(ages_trace - a)), adv_states])
  })

  win <- 100:200
  hcc_annual <- rate_to_prob(
    prob_to_rate(mean(
      diff(trace_c[win, "HCC"]) /
      pmax(trace_c[win[-length(win)], "F4_CC"], 1e-8)
    )) * 12
  )
  dcc_annual <- rate_to_prob(
    prob_to_rate(mean(
      diff(trace_c[win, "DCC"]) /
      pmax(trace_c[win[-length(win)], "F4_CC"], 1e-8)
    )) * 12
  )

  list(pct_adv = pct_adv, hcc_incidence = hcc_annual, dcc_rate = dcc_annual)
}

## ---- Log-likelihood --------------------------------------------------------
f_llik_calib <- function(v_params) {
  if (any(v_params < v_lb_calib) || any(v_params > v_ub_calib)) return(-Inf)
  out <- tryCatch(run_mash_calib(v_params), error = function(e) NULL)
  if (is.null(out)) return(-Inf)

  ll1 <- sum(dnorm(lst_targets_calib$pct_adv$value,
                   out$pct_adv,
                   lst_targets_calib$pct_adv$se, log = TRUE))
  ll2 <- dnorm(lst_targets_calib$hcc_incidence$value,
               out$hcc_incidence,
               lst_targets_calib$hcc_incidence$se, log = TRUE)
  ll3 <- dnorm(lst_targets_calib$dcc_rate$value,
               out$dcc_rate,
               lst_targets_calib$dcc_rate$se, log = TRUE)
  sum(ll1, ll2, ll3)
}

## ---- IMIS functions --------------------------------------------------------
n_resamp_imis <- 1000   

sample.prior <- function(n_samp) {
  m <- randomLHS(n = n_samp, k = n_param_calib)
  for (i in 1:n_param_calib)
    m[, i] <- qunif(m[, i], v_lb_calib[i], v_ub_calib[i])
  colnames(m) <- v_param_names_calib
  m
}

calc_log_prior <- function(v_params) {
  if (is.null(dim(v_params))) v_params <- matrix(v_params, nrow = 1)
  colnames(v_params) <- v_param_names_calib
  lp <- rep(0, nrow(v_params))
  for (i in 1:n_param_calib)
    lp <- lp + dunif(v_params[, i],
                     v_lb_calib[i], v_ub_calib[i], log = TRUE)
  lp
}

prior      <- function(v_params) exp(calc_log_prior(v_params))
likelihood <- function(v_params) {
  if (is.null(dim(v_params))) v_params <- matrix(v_params, nrow = 1)
  colnames(v_params) <- v_param_names_calib
  apply(v_params, 1, function(p) exp(f_llik_calib(p)))
}

## ---- Run IMIS (cached) -----------------------------------------------------
if (!file.exists("calibration_results.rds")) {

  set.seed(20250305)
  cat("Running IMIS Bayesian calibration...\n")

  t_imis   <- Sys.time()
  fit_imis <- IMIS(B        = 1000,
                   B.re     = n_resamp_imis,
                   number_k = 10,
                   D        = 0)
  cat("IMIS done in",
      round(difftime(Sys.time(), t_imis, units = "mins"), 1), "min\n")

  ## Extract posterior samples
  m_calib_res <- fit_imis$resample
  colnames(m_calib_res) <- v_param_names_calib

  ll_vec   <- apply(m_calib_res, 1, f_llik_calib)
  lpr_vec  <- calc_log_prior(m_calib_res)
  post_vec <- exp(lpr_vec + ll_vec)
  post_vec <- post_vec / sum(post_vec)

  m_calib_res <- cbind(m_calib_res,
                       Overall_fit    = ll_vec,
                       Posterior_prob = post_vec)

  ## Posterior summaries
  v_calib_post_mean <- colMeans(m_calib_res[, v_param_names_calib])
  m_calib_95cr      <- colQuantiles(m_calib_res[, v_param_names_calib],
                                    probs = c(0.025, 0.5, 0.975))
  v_calib_map       <- m_calib_res[which.max(m_calib_res[, "Posterior_prob"]),
                                   v_param_names_calib]

  ## Apply to base model
  .raw <- pmax(v_calib_post_mean[c("init_F0","init_F1","init_F2","init_F3")], 0)
  .f4  <- max(0, 1 - sum(.raw))
  .all <- c(.raw, .f4) / (sum(.raw) + .f4)

  v_init <- c(F0    = unname(.all[1]), F1 = unname(.all[2]),
               F2    = unname(.all[3]), F3 = unname(.all[4]),
               F4_CC = unname(.all[5]),
               DCC=0, HCC=0, LT_Y1_P=0, LT_Y1=0, Post_LT=0, Dead=0)

  ped_mult_calib <- unname(v_calib_post_mean["ped_mult_base"])

  ## Save
  saveRDS(list(
    fit_imis          = fit_imis,
    m_calib_res       = m_calib_res,
    v_calib_post_mean = v_calib_post_mean,
    m_calib_95cr      = m_calib_95cr,
    v_calib_map       = v_calib_map,
    v_init            = v_init,
    ped_mult_calib    = ped_mult_calib
  ), "calibration_results.rds")

  cat("Calibration complete — results saved to cache.\n")

} else {

  calib             <- readRDS("calibration_results.rds")
  fit_imis          <- calib$fit_imis
  m_calib_res       <- calib$m_calib_res
  v_calib_post_mean <- calib$v_calib_post_mean
  m_calib_95cr      <- calib$m_calib_95cr
  v_calib_map       <- calib$v_calib_map
  v_init            <- calib$v_init
  ped_mult_calib    <- calib$ped_mult_calib
  cat("Loaded calibration results from cache.\n")

}

