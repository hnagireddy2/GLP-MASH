  "Dead"    = "Death"
)

to_csv_state <- function(s) {
  if (s %in% names(state_map)) state_map[[s]] else s
}

get_p_month <- function(from, to) {
  from_csv <- to_csv_state(from)
  to_csv   <- to_csv_state(to)

  if (!from_csv %in% rownames(trans_mat)) return(0)
  if (!to_csv   %in% colnames(trans_mat)) return(0)

  trans_mat[from_csv, to_csv]
}

# Helper: annual hazard -> monthly probability
annual_to_month <- function(h_annual) {
  1 - exp(-h_annual / 12)
