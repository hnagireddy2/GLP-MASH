## ---- Parameters to calibrate -----------------------------------------------
v_param_names_calib <- c("init_F0", "init_F1", "init_F2",
                          "init_F3", "ped_mult_base")
n_param_calib <- length(v_param_names_calib)

v_lb_calib <- c(init_F0       = 0.10,
                init_F1       = 0.30,
                init_F2       = 0.02,
                init_F3       = 0.001,
                ped_mult_base = 0.10)

v_ub_calib <- c(init_F0       = 0.60,
                init_F1       = 0.75,
                init_F2       = 0.25,
                init_F3       = 0.10,
                ped_mult_base = 0.90)

## ---- Calibration targets ---------------------------------------------------
lst_targets_calib <- list(
  pct_adv = data.frame(
    age   = c(18,    25,    35),
    value = c(0.085, 0.130, 0.300),
    se    = c(0.07,  0.10,  0.20) * 0.5
  ),
  hcc_incidence = data.frame(
    value = 0.0175,
    se    = 0.010
  ),
  dcc_rate = data.frame(
    value = 0.0465,
    se    = 0.020
  )
