      run_owsa_icer(p_prog_month_local = pm, treat_dur_cycles_vec = dur)
    }
  )

  results[["state_cost"]] <- find_threshold(
    "State cost multiplier", 1.0, 0.5, 3.0,
    run_fn = function(x) {
      run_owsa_icer(cost_vector = costs_base * x, treat_dur_cycles_vec = dur)
    }
  )
  results[["ped_mult"]] <- find_threshold(
    "Pediatric multiplier floor", ped_mult_calib,
    lo_val = unname(m_calib_95cr["ped_mult_base", "2.5%"]),
    hi_val = unname(m_calib_95cr["ped_mult_base", "97.5%"]),
    run_fn = function(x) {
      aP_pm <- build_a_P(rr_regress, rr_progress, p_prog_month,
                         treat_dur_cycles = dur, ped_mult_base = x)
      tr_lsm  <- run_markov(aP_pm[,,,"LSM"],        v_init)
