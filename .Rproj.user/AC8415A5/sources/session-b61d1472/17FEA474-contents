m_pct_adv_post <- matrix(NA, nrow = nrow(m_calib_res), ncol = length(ages_trace))

for (i in 1:nrow(m_calib_res)) {
  p <- m_calib_res[i, v_param_names_calib]
  out_i <- tryCatch(run_mash_calib(p), error = function(e) NULL)
  if (!is.null(out_i)) {
    trace_i <- run_markov(
      build_a_P(rr_regress, rr_progress,
                treat_dur_cycles   = c(LSM=0L, Semaglutide=0L),
                treat_start_cycles = treat_start_immediate,
                ped_mult_base      = as.numeric(p["ped_mult_base"]))[,,,"LSM"],
      v_init
    )
    m_pct_adv_post[i, ] <- rowSums(trace_i[, adv_states])
  }
  if (i %% 100 == 0) cat(i, "/", nrow(m_calib_res), "\n")
}

